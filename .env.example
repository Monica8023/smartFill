# Local development only. Generate a long random value before starting the API.
SMARTFILL_ENVIRONMENT=development
SMARTFILL_API_TOKEN=replace-with-a-random-local-token
# MySQL example; keep the real password only in the ignored .env file.
SMARTFILL_DATABASE_URL=mysql+pymysql://smartfill:replace-me@127.0.0.1:3306/smartfill

# JSON arrays are required by pydantic-settings for list values.
SMARTFILL_ALLOWED_TARGET_ORIGINS=["https://target.example.com"]
SMARTFILL_CORS_ORIGINS=[]
SMARTFILL_REQUEST_LIMIT_PER_MINUTE=120
SMARTFILL_UPLOAD_MAX_BYTES=5242880
SMARTFILL_BATCH_MAX_RECORDS=1000

# Aliyun Bailian / DashScope. Keep the real key in .env or a secret manager.
SMARTFILL_DASHSCOPE_API_KEY=
SMARTFILL_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMARTFILL_DASHSCOPE_FAST_MODEL=qwen3-vl-flash
SMARTFILL_DASHSCOPE_STRONG_MODEL=qwen3-vl-plus

# Browser Worker. Set headless=false when an operator must complete CAPTCHA/MFA.
SMARTFILL_BROWSER_HEADLESS=true
# Optional trusted Chromium remote debugging endpoint.
SMARTFILL_BROWSER_CDP_URL=
SMARTFILL_BROWSER_ARTIFACTS_ROOT=artifacts
SMARTFILL_BROWSER_NAVIGATION_TIMEOUT_MS=30000
SMARTFILL_BROWSER_ACTION_TIMEOUT_MS=10000
